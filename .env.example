# Dedicated Neo4j instance for THIS project's domain graph (companies,
# regulators, events). Do not point this at the portfolio-tracking graph.
# Free options: Neo4j Aura Free, or `docker run -p 7687:7687 -p 7474:7474 neo4j`.
# NEO4J_DATABASE is only needed if your instance doesn't use the default
# "neo4j" database name -- Aura Free instances often don't (check the
# credentials file Aura gives you on creation).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=

# Tracing. Keep LANGCHAIN_TRACING_V2=false until LANGCHAIN_API_KEY is filled
# in -- true+blank key spams 401 Unauthorized on every single run instead of
# just skipping tracing.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=european-brokerage-market-intel

# Required for the Briefing agent (Week 2). Without this, briefing_agent.py
# raises RuntimeError on purpose rather than fabricating a placeholder SITREP.
ANTHROPIC_API_KEY=
