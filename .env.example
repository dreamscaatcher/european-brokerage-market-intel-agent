# Dedicated Neo4j instance for THIS project's domain graph (companies,
# regulators, events). Do not point this at the portfolio-tracking graph.
# Free options: Neo4j Aura Free, or `docker run -p 7687:7687 -p 7474:7474 neo4j`.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Tracing -- pick one.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=european-brokerage-market-intel

# LLM provider for the Analyst/Briefing agents (Week 2)
ANTHROPIC_API_KEY=
